# ========================================================
# LEARN OVERSEAS - NETLIFY CLOUD ENVIRONMENT VARIABLES
# ========================================================
# DO NOT COMMIT SENSITIVE VALUES TO GITHUB.
# Enter these in your Netlify Dashboard:
# Netlify Dashboard -> Site configuration -> Environment variables
# ========================================================

# 1. The Cloudflare / Ngrok tunnel URL forwarding to port 11435
LOCAL_AI_ENDPOINT=https://<your-tunnel-subdomain>.trycloudflare.com/api/generate

# 2. Your encrypted On-Premises API Key (Matches SHA-256 hash in api-keys.json)
LOCAL_AI_API_KEY=lo_live_qDYoGoQFKz7bM35ijtVa-9BwznoFZhqO

# 3. Model Name
LOCAL_AI_MODEL=llama3.1:latest

# ========================================================
# 4. CENTRALIZED CLOUD DATABASE (Cross-Device Synchronization)
# Compatible with Neon, Supabase, Railway, Render, or AWS RDS PostgreSQL.
# When provided, all student assessments, comparisons, users, and settings
# are centrally stored and synchronized across all desktop, web, and mobile sessions.
# If omitted, system falls back automatically to embedded local SQLite.
# ========================================================
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/learnoverseas?sslmode=require


