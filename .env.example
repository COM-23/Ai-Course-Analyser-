# ========================================================
# LEARN OVERSEAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Rename this file to '.env.local' for local development
# or copy values into your Netlify / Cloud dashboard.
# ========================================================

# --------------------------------------------------------
# OPTION 1: FOR LOCAL ON-PREMISE (Windows PC / Office LAN)
# --------------------------------------------------------
# Connects directly across the office switch to the Linux Ollama server.
# Blazing fast (<1ms lag), no internet required, no API key needed!
LOCAL_AI_ENDPOINT=http://192.168.0.66:11434/api/generate
LOCAL_AI_MODEL=llama3.1

# --------------------------------------------------------
# OPTION 2: FOR CLOUD DEPLOYMENT (Netlify / Vercel)
# --------------------------------------------------------
# In Netlify: Go to Site configuration -> Environment variables
# DO NOT commit live API keys to public Git repos!
#
# LOCAL_AI_ENDPOINT=https://headline-alive-subsidiaries-merge.trycloudflare.com/api/generate
# LOCAL_AI_API_KEY=lo_live_qDYoGoQFKz7bM35ijtVa-9BwznoFZhqO
# LOCAL_AI_MODEL=llama3.1
